# Copy this file to .env.local and fill it in. Never commit .env.local.
# Variables that start with NEXT_PUBLIC_ are sent to the browser. All others stay on the server.

# --- Supabase (Project Settings > API) ---
# Project URL, for example https://abcd1234.supabase.co. Required.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser because row-level security protects the data. Required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key. Bypasses row-level security, so it must stay on the server. Required.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
# 32 random bytes, base64. Encrypts the stored GitHub tokens and keys the rate-limit hashes. Required.
# Make one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- AI (set at least one key) ---
# Groq key from console.groq.com. Groq is asked first.
GROQ_API_KEY=
# Groq model ID. Optional; this is the default.
GROQ_MODEL=qwen/qwen3.8-27b
# Gemini key from Google AI Studio. Used when Groq fails or is not set.
GEMINI_API_KEY=
# Gemini model ID. Optional; this is the default.
GEMINI_MODEL=gemini-3.8-flash

# --- Site ---
# Public address of the app, without a trailing slash. Used for canonical URLs, the sitemap,
# share cards and OAuth redirects. In development the app always uses http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Search engines (optional) ---
# The content value of the Google Search Console HTML tag.
GOOGLE_SITE_VERIFICATION=
# The content value of the Bing Webmaster Tools msvalidate.01 tag.
BING_SITE_VERIFICATION=
